  <property name="windowTitle">
   <string>ArchDistribution - 프리미엄 분포지도 엔진</string>
  </property>
  <styleSheet>
   <string notr="true">QDialog { background-color: #f5f5f5; }
QGroupBox { font-size: 13px; font-weight: bold; border: 1px solid #c0c0c0; border-radius: 6px; margin-top: 20px; padding-top: 15px; background-color: #ffffff; }
QGroupBox::title { subcontrol-origin: margin; left: 15px; padding: 0 5px; color: #333333; }
QLabel { color: #333333; font-size: 11px; }
QLabel#lTitle { color: #2c3e50; font-size: 16px; font-weight: bold; }
QPushButton#btnRun { 
  background-color: #2980b9; 
  color: white; 
  border-radius: 4px; 
  font-weight: bold; 
  font-size: 14px; 
  border: 1px solid #2980b9;
  padding: 8px;
}
QPushButton#btnRun:hover { background-color: #3498db; }
QPushButton#btnRun:pressed { background-color: #1f618d; }
QLineEdit, QSpinBox, QDoubleSpinBox { border: 1px solid #bdc3c7; border-radius: 3px; padding: 4px; background-color: #ffffff; color: #000000; }

/* IMPACT FIX: Force Combo Box Popup to be White Background with Black Text */
QComboBox { border: 1px solid #bdc3c7; border-radius: 3px; padding: 4px; background-color: #ffffff; color: #000000; selection-background-color: #3498db; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #3498db;
    selection-color: #ffffff;
    outline: 0;
}
QComboBox::item { color: #000000; background-color: #ffffff; }
QComboBox::item:selected { background-color: #3498db; color: #ffffff; }

QListWidget { border: 1px solid #bdc3c7; border-radius: 3px; background-color: #ffffff; color: #000000; selection-background-color: #3498db; selection-color: #ffffff; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QListWidget:focus { border: 1px solid #3498db; }
QPlainTextEdit#txtLogs { background-color: #2c3e50; color: #ecf0f1; font-family: 'Consolas', monospace; font-size: 10px; border-radius: 3px; }
</string>
  </styleSheet>
